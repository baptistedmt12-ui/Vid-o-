[{"start": 0.0, "end": 1.48, "text": " se jettent dans le vide !", "words": [[0.0, 0.42, " se"], [0.42, 0.72, " jettent"], [0.72, 0.82, " dans"], [0.82, 1.0, " le"], [1.0, 1.22, " vide"], [1.22, 1.48, " !"]]}, {"start": 1.48, "end": 3.58, "text": " Le salon s'ouvre entièrement sur l'extérieur,", "words": [[1.48, 1.62, " Le"], [1.62, 1.86, " salon"], [1.86, 2.04, " s"], [2.04, 2.28, "'ouvre"], [2.28, 2.74, " entièrement"], [2.74, 2.98, " sur"], [2.98, 3.14, " l"], [3.14, 3.58, "'extérieur,"]]}, {"start": 3.86, "end": 5.24, "text": " un coin-feu face à l'océan,", "words": [[3.86, 3.96, " un"], [3.96, 4.2, " coin"], [4.2, 4.44, "-feu"], [4.44, 4.7, " face"], [4.7, 4.8, " à"], [4.8, 4.9, " l"], [4.9, 5.24, "'océan,"]]}, {"start": 5.38, "end": 6.88, "text": " un dressing plus grand qu'un appart,", "words": [[5.38, 5.52, " un"], [5.52, 5.86, " dressing"], [5.86, 6.16, " plus"], [6.16, 6.26, " grand"], [6.26, 6.36, " qu"], [6.36, 6.52, "'un"], [6.52, 6.88, " appart,"]]}, {"start": 7.06, "end": 8.78, "text": " et même un salon cinéma !", "words": [[7.06, 7.34, " et"], [7.34, 7.54, " même"], [7.54, 7.88, " un"], [7.88, 8.22, " salon"], [8.22, 8.6, " cinéma"], [8.6, 8.78, " !"]]}, {"start": 8.78, "end": 9.42, "text": " Et à la fin,", "words": [[8.78, 8.88, " Et"], [8.88, 9.06, " à"], [9.06, 9.2, " la"], [9.2, 9.42, " fin,"]]}, {"start": 9.64, "end": 10.98, "text": " tu vas devoir deviner son prix.", "words": [[9.64, 9.64, " tu"], [9.64, 9.86, " vas"], [9.86, 10.14, " devoir"], [10.14, 10.58, " deviner"], [10.58, 10.78, " son"], [10.78, 10.98, " prix."]]}, {"start": 11.16, "end": 12.16, "text": " On commence par l'entrée,", "words": [[11.16, 11.32, " On"], [11.32, 11.6, " commence"], [11.6, 11.8, " par"], [11.8, 11.96, " l"], [11.96, 12.16, "'entrée,"]]}, {"start": 12.34, "end": 13.2, "text": " des allées de gazon", "words": [[12.34, 12.58, " des"], [12.58, 12.78, " allées"], [12.78, 12.96, " de"], [12.96, 13.2, " gazon"]]}, {"start": 13.2, "end": 15.02, "text": " et une façade ultra moderne,", "words": [[13.2, 13.42, " et"], [13.42, 13.64, " une"], [13.64, 14.08, " façade"], [14.08, 14.58, " ultra"], [14.58, 15.02, " moderne,"]]}, {"start": 15.14, "end": 16.7, "text": " une porte pivotante géante", "words": [[15.14, 15.32, " une"], [15.32, 15.6, " porte"], [15.6, 16.18, " pivotante"], [16.18, 16.7, " géante"]]}, {"start": 16.7, "end": 18.64, "text": " et un lustre doré dès le couloir.", "words": [[16.7, 17.0, " et"], [17.0, 17.18, " un"], [17.18, 17.54, " lustre"], [17.54, 17.88, " doré"], [17.88, 18.08, " dès"], [18.08, 18.2, " le"], [18.2, 18.64, " couloir."]]}, {"start": 18.8, "end": 19.4, "text": " Le salon ?", "words": [[18.8, 18.94, " Le"], [18.94, 19.22, " salon"], [19.22, 19.4, " ?"]]}, {"start": 19.4, "end": 21.16, "text": " Les baies vitrées disparaissent complètement,", "words": [[19.4, 19.54, " Les"], [19.54, 19.74, " baies"], [19.74, 20.02, " vitrées"], [20.02, 20.66, " disparaissent"], [20.66, 21.16, " complètement,"]]}, {"start": 21.32, "end": 23.24, "text": " la maison est grande ouverte sur la vue,", "words": [[21.32, 21.5, " la"], [21.5, 21.76, " maison"], [21.76, 22.18, " est"], [22.18, 22.34, " grande"], [22.34, 22.74, " ouverte"], [22.74, 22.94, " sur"], [22.94, 23.1, " la"], [23.1, 23.24, " vue,"]]}, {"start": 23.46, "end": 24.0, "text": " et dehors,", "words": [[23.46, 23.76, " et"], [23.76, 24.0, " dehors,"]]}, {"start": 24.18, "end": 25.54, "text": " la piscine a débordement", "words": [[24.18, 24.4, " la"], [24.4, 24.78, " piscine"], [24.78, 25.02, " a"], [25.02, 25.54, " débordement"]]}, {"start": 25.54, "end": 27.26, "text": " avec la ville à perte de vue.", "words": [[25.54, 25.88, " avec"], [25.88, 26.14, " la"], [26.14, 26.32, " ville"], [26.32, 26.68, " à"], [26.68, 26.94, " perte"], [26.94, 27.14, " de"], [27.14, 27.26, " vue."]]}, {"start": 27.42, "end": 28.12, "text": " Côté jardin,", "words": [[27.42, 27.7, " Côté"], [27.7, 28.12, " jardin,"]]}, {"start": 28.22, "end": 29.48, "text": " une pelouse impeccable,", "words": [[28.22, 28.4, " une"], [28.4, 28.78, " pelouse"], [28.78, 29.48, " impeccable,"]]}, {"start": 29.48, "end": 30.96, "text": " parfaite pour les soirées d'été.", "words": [[29.48, 30.12, " parfaite"], [30.12, 30.3, " pour"], [30.3, 30.46, " les"], [30.46, 30.66, " soirées"], [30.66, 30.78, " d"], [30.78, 30.96, "'été."]]}, {"start": 31.38, "end": 32.1, "text": " Un deuxième salon,", "words": [[31.38, 31.38, " Un"], [31.38, 31.74, " deuxième"], [31.74, 32.1, " salon,"]]}, {"start": 32.38, "end": 33.04, "text": " ultra cosy,", "words": [[32.38, 32.66, " ultra"], [32.66, 33.04, " cosy,"]]}, {"start": 33.2, "end": 34.64, "text": " et des chambres baignées de lumière.", "words": [[33.2, 33.26, " et"], [33.26, 33.44, " des"], [33.44, 33.82, " chambres"], [33.82, 34.18, " baignées"], [34.18, 34.38, " de"], [34.38, 34.64, " lumière."]]}, {"start": 35.02, "end": 36.78, "text": " Chaque chambre a sa propre salle de bain,", "words": [[35.02, 35.26, " Chaque"], [35.26, 35.54, " chambre"], [35.54, 35.76, " a"], [35.76, 36.0, " sa"], [36.0, 36.28, " propre"], [36.28, 36.48, " salle"], [36.48, 36.64, " de"], [36.64, 36.78, " bain,"]]}, {"start": 37.0, "end": 37.54, "text": " et partout,", "words": [[37.0, 37.14, " et"], [37.14, 37.54, " partout,"]]}, {"start": 37.78, "end": 38.2, "text": " du bois,", "words": [[37.78, 37.9, " du"], [37.9, 38.2, " bois,"]]}, {"start": 38.42, "end": 38.96, "text": " du marbre", "words": [[38.42, 38.64, " du"], [38.64, 38.96, " marbre"]]}, {"start": 38.96, "end": 40.44, "text": " et de la lumière naturelle.", "words": [[38.96, 39.22, " et"], [39.22, 39.4, " de"], [39.4, 39.66, " la"], [39.66, 39.84, " lumière"], [39.84, 40.44, " naturelle."]]}, {"start": 40.62, "end": 41.26, "text": " Le dressing,", "words": [[40.62, 40.82, " Le"], [40.82, 41.26, " dressing,"]]}, {"start": 41.56, "end": 43.32, "text": " avec son îlot en marbre et son lustre.", "words": [[41.56, 41.7, " avec"], [41.7, 41.9, " son"], [41.9, 42.1, " îlot"], [42.1, 42.32, " en"], [42.32, 42.56, " marbre"], [42.56, 42.82, " et"], [42.82, 42.94, " son"], [42.94, 43.32, " lustre."]]}, {"start": 43.46, "end": 44.0, "text": " La cuisine,", "words": [[43.46, 43.66, " La"], [43.66, 44.0, " cuisine,"]]}, {"start": 44.22, "end": 46.42, "text": " un îlot noir immense sous une verrière.", "words": [[44.22, 44.38, " un"], [44.38, 44.64, " îlot"], [44.64, 44.92, " noir"], [44.92, 45.5, " immense"], [45.5, 45.86, " sous"], [45.86, 46.06, " une"], [46.06, 46.42, " verrière."]]}, {"start": 46.62, "end": 47.46, "text": " Et la terrasse,", "words": [[46.62, 46.78, " Et"], [46.78, 47.0, " la"], [47.0, 47.46, " terrasse,"]]}, {"start": 47.64, "end": 48.12, "text": " honnêtement,", "words": [[47.64, 48.12, " honnêtement,"]]}, {"start": 48.2, "end": 49.32, "text": " c'est la plus folle !", "words": [[48.2, 48.36, " c"], [48.36, 48.38, "'est"], [48.38, 48.56, " la"], [48.56, 48.76, " plus"], [48.76, 49.04, " folle"], [49.04, 49.32, " !"]]}, {"start": 49.32, "end": 49.78, "text": " Transat,", "words": [[49.32, 49.78, " Transat,"]]}, {"start": 49.94, "end": 50.46, "text": " coin-feu", "words": [[49.94, 50.26, " coin"], [50.26, 50.46, "-feu"]]}, {"start": 50.46, "end": 51.74, "text": " et l'océan au fond !", "words": [[50.46, 50.68, " et"], [50.68, 50.94, " l"], [50.94, 51.24, "'océan"], [51.24, 51.46, " au"], [51.46, 51.56, " fond"], [51.56, 51.74, " !"]]}, {"start": 51.74, "end": 53.62, "text": " Une salle de jeux avec sa table de poker,", "words": [[51.74, 51.92, " Une"], [51.92, 52.14, " salle"], [52.14, 52.38, " de"], [52.38, 52.48, " jeux"], [52.48, 52.74, " avec"], [52.74, 52.92, " sa"], [52.92, 53.12, " table"], [53.12, 53.36, " de"], [53.36, 53.62, " poker,"]]}, {"start": 53.92, "end": 54.68, "text": " et pour finir,", "words": [[53.92, 54.08, " et"], [54.08, 54.22, " pour"], [54.22, 54.68, " finir,"]]}, {"start": 54.76, "end": 56.94, "text": " le salon cinéma avec son canapé géant.", "words": [[54.76, 54.98, " le"], [54.98, 55.28, " salon"], [55.28, 55.72, " cinéma"], [55.72, 56.04, " avec"], [56.04, 56.24, " son"], [56.24, 56.7, " canapé"], [56.7, 56.94, " géant."]]}, {"start": 57.08, "end": 57.44, "text": " Alors,", "words": [[57.08, 57.44, " Alors,"]]}, {"start": 57.64, "end": 58.14, "text": " à ton avis,", "words": [[57.64, 57.74, " à"], [57.74, 57.86, " ton"], [57.86, 58.14, " avis,"]]}, {"start": 58.26, "end": 59.04, "text": " elle coûte combien ?", "words": [[58.26, 58.4, " elle"], [58.4, 58.58, " coûte"], [58.58, 58.86, " combien"], [58.86, 59.04, " ?"]]}, {"start": 59.04, "end": 59.3, "text": " Un,", "words": [[59.04, 59.3, " Un,"]]}, {"start": 59.54, "end": 60.68, "text": " moins de 20 millions d'euros,", "words": [[59.54, 59.74, " moins"], [59.74, 59.96, " de"], [59.96, 60.1, " 20"], [60.1, 60.32, " millions"], [60.32, 60.48, " d"], [60.48, 60.68, "'euros,"]]}, {"start": 60.9, "end": 61.32, "text": " ou deux,", "words": [[60.9, 61.02, " ou"], [61.02, 61.32, " deux,"]]}, {"start": 61.56, "end": 62.44, "text": " plus de 20 millions ?", "words": [[61.56, 61.66, " plus"], [61.66, 61.84, " de"], [61.84, 61.94, " 20"], [61.94, 62.2, " millions"], [62.2, 62.44, " ?"]]}, {"start": 62.44, "end": 63.32, "text": " Dis-le en commentaire !", "words": [[62.44, 62.56, " Dis"], [62.56, 62.68, "-le"], [62.68, 62.84, " en"], [62.84, 63.24, " commentaire"], [63.24, 63.32, " !"]]}]